{
    "version": 2,
    "builds": [
        {
            "src": "package.json",
            "use": "@vercel/node",
            "config": {
                "cmd": "npm run start-production"
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "bin/www.js"
        }
    ]
}
